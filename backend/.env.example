PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Path where contact messages are stored
MESSAGES_FILE=storage/messages.json
# Secret used to read messages: GET /api/contact with header "x-admin-token"
ADMIN_TOKEN=change-me
# Optional: Google Apps Script web app that relays new messages to Telegram
# (see deploy/telegram-relay.gs). Leave empty to disable notifications.
NOTIFY_WEBHOOK_URL=
# Shared secret checked by the relay script
NOTIFY_SECRET=
